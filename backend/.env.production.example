# Nimpass backend — PRODUCTION (Nimiq Mainnet)
#
# Placeholders only. Never commit a real secret: this repository is public
# (docs/09-SECURITY.md §28-§30). Supply these through the hosting provider's
# secret store, not through a file in the image.
#
# The development/Testnet counterpart is `.env.example`. The two are separate
# files rather than one file with comments because the difference between them
# is real money, and a single file invites editing the wrong line.

# --- Environment and network ------------------------------------------------
#
# These two are bound to each other by config validation: `production` requires
# `MAINNET`, and `development`/`test` require `TESTNET`. The server refuses to
# start on any other combination, so there is no configuration in which a
# production build silently settles against Testnet.
APP_ENV=production
NIMIQ_NETWORK=MAINNET

HTTP_ADDR=:8080

# --- Database ---------------------------------------------------------------
#
# A production database must be its OWN database, not a promoted Testnet one.
#
# The server binds a database to one network/environment on first boot and
# refuses to start against rows from another (`BindDeployment`). That is
# deliberate and must not be worked around: a transaction hash belongs
# permanently to the chain it was made on, so historical Testnet purchases stay
# Testnet purchases forever. Point production at an empty database and run
# `go run ./cmd/migrate` against it.
#
# `sslmode` must be require, verify-ca or verify-full — prefer verify-full with
# the provider's CA. Anything weaker is refused in production.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/nimpass?sslmode=verify-full

# --- Nimiq RPC --------------------------------------------------------------
#
# The authoritative source for every payment this deployment confirms. It must
# be a synced Nimiq PoS **history** node on Mainnet: beyond
# `getTransactionByHash`, the desktop QR checkout needs
# `getTransactionsByAddress`, which only an address-indexing history node
# serves (docs/DECISIONS.md ADR-010).
#
# Startup proves the endpoint's chain before anything is verified against it.
# A wrong chain fails the process closed and fails `/health/ready` with
# NIMIQ_NETWORK_MISMATCH; an unreachable or throttled node is uncertainty and
# the service keeps serving while reconciliation retries.
#
# https://rpc.nimiqwatch.com is a real Mainnet history endpoint and works with
# this backend unchanged (verified 2026-09-18: serves MainAlbatross, networkId
# 24, and every method Nimpass calls). It is a free public gateway, though:
# 20 requests per fixed 10-second window per IP, no SLA, and `getNetworkId`
# outside its allowlist — the Nimiq documentation presents open RPC servers for
# testing and development. Running a Mainnet deployment against it means
# accepting that a shared budget, not the chain, can decide how fast a customer
# sees their Pass.
#
# Supply your own node's URL here for a real launch. HTTPS is required.
NIMIQ_RPC_URL=https://REPLACE-WITH-YOUR-MAINNET-HISTORY-NODE

# --- Origin, cookies, proxies -----------------------------------------------
#
# The exact HTTPS origin of the frontend. One origin, no path, no trailing
# slash. Deploy the frontend and the API on the same site so the SameSite=Lax
# session cookie works.
PUBLIC_ORIGIN=https://app.example.com
SESSION_COOKIE_MODE=secure
# Only the actual ingress peers. Never the whole internet.
TRUSTED_PROXY_CIDRS=

# --- Wallet signature scheme ------------------------------------------------
#
# Which envelope Nimiq Pay signs: raw | hub. This is not a Mainnet question —
# it is a property of the wallet host and is identical on both networks — so
# carry over whatever a real-device capture settled on Testnet. See
# `cmd/verify-sign-fixture` and docs/DECISIONS.md ADR-003.
NIMIQ_SIGNING_SCHEME=hub

# --- Settlement policy ------------------------------------------------------
#
# inclusion | finality (default: inclusion). Governs the WAIT, never the
# VALIDATION: network, recipient, exact Luna, reference or sending wallet,
# execution result, canonical inclusion, the intent's window and global hash
# uniqueness are required under both.
#
# On Mainnet a batch is 60 blocks at roughly one second each, so `finality`
# means a nought-to-sixty-second wait on a payment that is already on chain,
# and `inclusion` issues the Pass in seconds and promotes the receipt to
# FINALIZED in the background. See docs/DECISIONS.md ADR-021.
NIMIQ_CONFIRMATION_POLICY=inclusion

# --- Release layout ---------------------------------------------------------
MIGRATIONS_DIR=migrations
MEDIA_DIR=var/media

# Never set in production: TEST_DATABASE_URL, and anything under cmd/seed.
