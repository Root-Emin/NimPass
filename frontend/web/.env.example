# Nimpass frontend environment
#
# Never put private keys, seed phrases or wallet secrets in this file or in any
# VITE_* variable: everything prefixed with VITE_ is inlined into the public
# bundle. See docs/09-SECURITY.md §27-§30.

# Base URL of the Nimpass Go backend (owner: backend).
#
# IMPORTANT for Nimiq Pay testing: inside the WebView, `localhost` resolves to
# the *phone*, not your dev machine. When testing on a device, point this at the
# dev machine's LAN IP (e.g. http://192.168.1.105:8080) and make sure the
# backend allows the mini app's origin in Access-Control-Allow-Origin.
# Ref: https://nimiq.dev/mini-apps (External APIs and backends)
VITE_API_BASE_URL=http://localhost:8080

# Nimiq network this build talks to. Must be explicit — a testnet transaction is
# never a mainnet purchase. See docs/04-NIMIQ-MINI-APPS.md §49.
# One of: TESTNET | MAINNET (spelled as the backend's domain.NimiqNetwork).
# Nimiq Pay picks its own network via its hidden dev menu; this tells Nimpass
# which network its backend is configured for.
VITE_NIMIQ_NETWORK=TESTNET
VITE_APP_ENV=development

# Milliseconds to wait for Nimiq Pay to inject the provider before concluding
# this is an ordinary browser and falling through to the Nimiq Hub. Optional,
# defaults to 3000.
VITE_NIMIQ_INIT_TIMEOUT_MS=3000

# Base of the Nimiq Pay Mini App opener link used for the browser -> Nimiq Pay
# handoff (docs/04-NIMIQ-MINI-APPS.md §41-§44). Optional; defaults to the
# documented opener, https://nimpay.app/miniapps/open. Override only if the
# official format changes — check the Developer Center rather than guessing.
# VITE_NIMIQ_PAY_OPENER_BASE=https://nimpay.app/miniapps/open

# Nimiq Hub endpoint, for wallet access in an ordinary browser
# (https://nimiq.dev/hub/getting-started). Optional: the endpoint normally
# follows VITE_NIMIQ_NETWORK —
#   TESTNET -> https://hub.nimiq-testnet.com
#   MAINNET -> https://hub.nimiq.com
# Set this only to run against a locally served Hub during development. It is
# deliberately ignored on mainnet: a misconfigured build must not be able to
# route real payments through an arbitrary origin (docs/09-SECURITY.md §101).
# VITE_NIMIQ_HUB_URL=http://localhost:8080

# Development only. Set to 1 to serve the public catalogue (providers, services,
# packages) from presentation fixtures while the backend is being built.
# Ignored in production builds. Purchases, passes and redemptions are never
# faked. See src/dev/README.md.
VITE_DEV_FIXTURES=0

# Optional canonical origin for cross-device purchase links. ./start.sh derives
# the LAN URL automatically; production normally uses the current HTTPS origin.
# VITE_PUBLIC_ORIGIN=https://nimpass.example
# ./start.sh uses VITE_API_BASE_URL=/ and a local-only same-origin API proxy.
# For production, deploy /api behind your HTTPS reverse proxy or configure the
# explicit API origin with the existing CORS/cookie restrictions.
